# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only: lets the app cache ElevenLabs audio in Supabase Storage
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Who can open the Admin page (comma separated)
ADMIN_EMAILS=gwilliams@ardentadvisors.com
# Who may use the Claude and ElevenLabs features (comma separated). Admins always can;
# others can also be given access from the Admin page.
ALLOWED_EMAILS=gwilliams@ardentadvisors.com

# Claude (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# ElevenLabs (optional; without it the app uses the device's own voices)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
